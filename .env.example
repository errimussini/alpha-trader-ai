# ---- Copia in .env e modifica. Il file .env NON va mai committato. ----
ENVIRONMENT=development
POSTGRES_PASSWORD=alpha

# Segreto per i token JWT: genera con  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-questo-valore

# Amministratore creato al primo avvio (solo se il database non ha utenti)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=cambia-questa-password

# Provider dati: yahoo (gratuito, non ufficiale) | demo (sintetico) | csv (file in backend/data/csv) | eodhd (a pagamento)
MARKET_DATA_PROVIDER=yahoo
# EODHD_API_KEY=            # solo se MARKET_DATA_PROVIDER=eodhd

# Quotazioni più vecchie di questa soglia sospendono ordini e raccomandazioni
MAX_QUOTE_AGE_MINUTES=60

# Parametri iniziali di rischio (da validare con test, non ottimizzati)
INITIAL_PAPER_CAPITAL=10000
RISK_PER_TRADE_PCT=0.5
MAX_AGGREGATE_RISK_PCT=3.0
MAX_POSITION_EXPOSURE_PCT=15
MAX_SECTOR_EXPOSURE_PCT=30
MIN_CASH_RESERVE_PCT=5
MAX_DAILY_LOSS_PCT=2
MAX_TOTAL_DRAWDOWN_PCT=10
COMMISSION_PER_ORDER=2.00
SLIPPAGE_BPS=5
